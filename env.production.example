# Database Configuration
DATABASE_URL=postgresql://ahachatai:your_secure_password@postgres:5432/ahachatai
POSTGRES_DB=ahachatai
POSTGRES_USER=ahachatai
POSTGRES_PASSWORD=your_secure_password

# Redis Configuration
REDIS_URL=redis://redis:6379

# MinIO Configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=ahachatai
MINIO_SECRET_KEY=your_secure_minio_password
MINIO_ROOT_USER=ahachatai
MINIO_ROOT_PASSWORD=your_secure_minio_password

# Application URLs
PARTYSOCKET_URL=http://partysocket:1999
NEXT_PUBLIC_ASSET_URL=http://minio:9000/ahachatai/public

# Authentication (if using Better Auth)
AUTH_SECRET=your_auth_secret_key_here
AUTH_URL=http://your-domain.com

# External Services (if applicable)
NEXT_PUBLIC_BILLING_URL=
