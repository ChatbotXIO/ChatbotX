    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "ConnectSession",
        "name": "ConnectSession_status_check",
        "value": "\"status\" IN ('pending', 'authorized', 'awaiting_selection', 'completed', 'failed', 'expired', 'cancelled')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "ConnectSession",
        "name": "ConnectSession_purpose_check",
        "value": "\"purpose\" IN ('connect', 'reconnect', 'facebook_ads', 'messaging_ads', 'lead_ads', 'meta_catalog')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "ConnectSession",
        "name": "ConnectSession_errorCode_check",
        "value": "\"errorCode\" IN ('state_mismatch', 'expired', 'provider_denied', 'exchange_failed', 'provider_error', 'no_candidates', 'already_connected', 'quota_exceeded', 'trial_expired', 'internal_error')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "ConnectSession",
        "name": "ConnectSession_errorCode_terminal_failure_check",
        "value": "\"errorCode\" IS NULL OR \"status\" IN ('failed', 'expired', 'cancelled')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "ConnectSession",
        "name": "ConnectSession_terminal_consumedAt_check",
        "value": "(\"status\" IN ('completed', 'failed', 'expired', 'cancelled')) = (\"consumedAt\" IS NOT NULL)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "ConnectSession",
        "name": "ConnectSession_terminal_clears_encryptedAuth_check",
        "value": "\"status\" NOT IN ('completed', 'failed', 'expired', 'cancelled') OR \"encryptedAuth\" IS NULL",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "ConnectSession",
        "name": "ConnectSession_active_reconnect_requires_target_check",
        "value": "\"purpose\" <> 'reconnect' OR \"status\" IN ('completed', 'failed', 'expired', 'cancelled') OR \"targetConnectionId\" IS NOT NULL",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "Connection",
        "name": "Connection_kind_relation_check",
        "value": "(\n        (\"kind\" = 'channel' AND \"inboxId\" IS NOT NULL AND \"channel\" IS NOT NULL)\n        OR\n        (\"kind\" = 'integration' AND \"inboxId\" IS NULL AND \"channel\" IS NULL AND \"integrationId\" IS NOT NULL)\n      )",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "Connection",
        "name": "Connection_inbox_integration_exclusive_check",
        "value": "NOT (\"inboxId\" IS NOT NULL AND \"integrationId\" IS NOT NULL)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "Connection",
        "name": "Connection_kind_check",
        "value": "\"kind\" IN ('channel', 'integration')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "Connection",
        "name": "Connection_status_check",
        "value": "\"status\" IN ('connected', 'degraded', 'needs_reauth', 'paused', 'disconnected')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "Connection",
        "name": "Connection_statusReason_check",
        "value": "\"statusReason\" IN ('manual', 'workspace_purge', 'trial_expired', 'tenant_suspended', 'token_revoked', 'provider_revoked', 'refresh_failed', 'verify_failed', 'quota_exceeded', 'orphaned_webhook')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "Connection",
        "name": "Connection_status_reason_check",
        "value": "(\"status\" = 'connected') = (\"statusReason\" IS NULL)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "Connection",
        "name": "Connection_disconnectedAt_check",
        "value": "(\"status\" = 'disconnected') = (\"disconnectedAt\" IS NOT NULL)",
        "entityType": "checks"
      }
    },
