{
  "name": "chatbotx",
  "version": "0.0.0-dev",
  "description": "ChatbotX CLI - Command line interface for the ChatbotX API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChatbotXIO/ChatbotX.git",
    "directory": "apps/cli"
  },
  "main": "dist/index.cjs",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "chatbotx": "./dist/index.cjs"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev:cli": "tsx src/index.ts",
    "prepublishOnly": "node --input-type=commonjs -e \"const v=require('./package.json').version; if (v === '0.0.0-dev') { console.error('chatbotx: version is the 0.0.0-dev placeholder — publish via .github/workflows/publish-cli.yml'); process.exit(1) }\"",
    "start": "node ./dist/index.cjs",
    "test": "pnpm build && vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [
    "chatbotX",
    "cli",
    "scheduling",
    "automation",
    "ai-agent",
    "command-line"
  ],
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "~24.12.2",
    "@types/yargs": "^17.0.35",
    "tsdown": "0.22.3",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
