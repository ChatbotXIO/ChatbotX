{
  "name": "chatbotx-cli",
  "version": "0.1.0",
  "description": "ChatbotX CLI - Command line interface for the ChatbotX API",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "chatbotx": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsup src/index.ts --watch",
    "build": "tsup src/index.ts",
    "start": "node ./dist/index.js",
    "publish": "pnpm build && pnpm publish --access public --no-git-checks"
  },
  "keywords": [
    "chatbotX",
    "cli",
    "scheduling",
    "automation",
    "ai-agent",
    "command-line"
  ],
  "dependencies": {
    "@chatbotx/public-apis": "workspace:*",
    "ky": "^1.14.3",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@aha.chat/typescript-config": "workspace:*",
    "@types/yargs": "^17.0.35",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  }
}
