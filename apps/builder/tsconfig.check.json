{
  // Used by the pre-commit hook only (CHECK_TYPES_SKIP_TESTS=1): the same
  // program as tsconfig.json without test files, which is ~10% faster and
  // ~1 GB lighter. CI still runs the full tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": { "tsBuildInfoFile": "./tsconfig.check.tsbuildinfo" },
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
