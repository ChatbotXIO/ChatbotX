{
  "name": "chatbotx-mcp",
  "version": "0.0.0-dev",
  "description": "MCP Server for ChatbotX — gives AI agents access to your ChatbotX workspace via the Model Context Protocol",
  "keywords": [
    "mcp",
    "chatbotx",
    "ai",
    "model-context-protocol"
  ],
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "bin": {
    "chatbotx-mcp": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev:mcp": "dotenv -e ../../.env -e .env -- tsx --watch src/index.ts",
    "prepublishOnly": "node --input-type=commonjs -e \"const v=require('./package.json').version; if (v === '0.0.0-dev') { console.error('chatbotx-mcp: version is the 0.0.0-dev placeholder — publish via .github/workflows/publish-chatbotx-mcp.yml'); process.exit(1) }\"",
    "start": "node dist/index.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "eval:business": "tsx evals/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@t3-oss/env-core": "^0.13.11",
    "dotenv": "^17.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.54",
    "ai": "^6.0.170",
    "@types/node": "24.x",
    "dotenv-cli": "^11.0.0",
    "tsdown": "0.22.3",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
