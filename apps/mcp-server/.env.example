# ─── Production reference (app.chatbotx.io/mcp) ─────────────────────────────
# Load balancer forwards the complete /mcp/ prefix to this server without
# stripping it. The endpoint event and OAuth bearer challenge embed this path.
CHATBOTX_API_URL=https://app.chatbotx.io/api
CHATBOTX_MCP_TRANSPORT=sse
CHATBOTX_MCP_HOST=0.0.0.0
CHATBOTX_MCP_PORT=3333
CHATBOTX_MCP_MESSAGES_PATH=/mcp/messages
CHATBOTX_MCP_SSE_PATH=/mcp/sse
CHATBOTX_MCP_PUBLIC_URL=https://app.chatbotx.io
CHATBOTX_MCP_OAUTH_ENABLED=true
# Keep empty for a shared HTTP deployment. This stdio-only fallback would
# otherwise authorize every unauthenticated HTTP request with the server token.
CHATBOTX_API_KEY=

# ─── ChatbotX API ────────────────────────────────────────────────────────────
# API base URL including /api. The server fetches {CHATBOTX_API_URL}/public-spec.json.
# CHATBOTX_API_URL=https://app.chatbotx.io/api

# Workspace token for stdio only. It MUST stay empty on a shared HTTP deployment.
# CHATBOTX_API_KEY=

# ─── MCP Server (SSE / HTTP transport only) ──────────────────────────────────
# "stdio" | "sse" | "both". Containers should use sse to avoid starting stdio on closed stdin.
# CHATBOTX_MCP_TRANSPORT=sse
# CHATBOTX_MCP_HOST=0.0.0.0
# CHATBOTX_MCP_PORT=3333
# The load balancer must forward this full /mcp/ prefix unchanged.
# CHATBOTX_MCP_MESSAGES_PATH=/mcp/messages
# CHATBOTX_MCP_SSE_PATH=/mcp/sse

# "*" is required for ChatGPT and browser clients; rely on OAuth rather than CORS.
# CHATBOTX_MCP_CORS_ORIGIN=*

# Required in production. This is the public origin; any path is ignored when
# resource metadata is built. Leaving it unset can advertise http:// behind a TLS proxy.
# CHATBOTX_MCP_PUBLIC_URL=https://app.chatbotx.io
# CHATBOTX_MCP_OAUTH_ENABLED=true

# How long fetched OpenAPI spec/tool data is trusted, in ms.
# CHATBOTX_SPEC_TTL_MS=300000
# Maximum duration for OpenAPI, introspection, and tool-call HTTP requests, in ms.
# CHATBOTX_HTTP_TIMEOUT_MS=30000
# Logger level used by @chatbotx.io/logger.
# LOG_LEVEL=info
