# ─── Production reference (app.chatbotx.io/mcp) ─────────────────────────────
# The load balancer forwards the complete /mcp/ prefix to this server without
# stripping it. Endpoint events and OAuth bearer challenges embed this path.
CHATBOTX_API_URL=https://app.chatbotx.io/api
# Keep empty for a shared HTTP deployment. This stdio-only fallback would
# otherwise authorize every unauthenticated HTTP request with the server token.
CHATBOTX_API_KEY=
CHATBOTX_MCP_TRANSPORT=sse
CHATBOTX_MCP_HOST=0.0.0.0
CHATBOTX_MCP_PORT=3333
# Prefix of every route: /mcp/messages, /mcp/sse, /mcp/openai, /mcp/claude
CHATBOTX_MCP_BASE_PATH=/mcp
# "*" is required for ChatGPT and browser clients; rely on OAuth rather than CORS.
CHATBOTX_MCP_CORS_ORIGIN=*
CHATBOTX_MCP_OAUTH_ENABLED=true
# Public builder origin. Leaving it unset can advertise an internal HTTP host.
CHATBOTX_MCP_PUBLIC_URL=https://app.chatbotx.io
# CHATBOTX_ALLOW_SELF_SIGNED_CERT=false
# CHATBOTX_MCP_OAUTH_ISSUER=https://app.chatbotx.io
# CHATBOTX_MCP_SERVER_NAME=chatbotx-mcp
# CHATBOTX_MCP_SERVER_INSTRUCTIONS=
# CHATBOTX_SPEC_TTL_MS=300000
# CHATBOTX_HTTP_TIMEOUT_MS=30000
# Per-process limits on every MCP route; 0 disables. See README "Rate limits".
# CHATBOTX_MCP_RATE_LIMIT_PER_MINUTE=600
# Set the hop count to the proxies appending X-Forwarded-For before enabling
# the per-IP rejected-token limit; a wrong count lets clients forge their IP.
# CHATBOTX_MCP_TRUSTED_PROXY_HOPS=0
# CHATBOTX_MCP_AUTH_FAILURE_LIMIT_PER_MINUTE=0
# Deprecated ?workspace_token= / ?token= on /sse and /messages. Set false once
# the "MCP token sent in the URL query" warning stops appearing in the logs.
# CHATBOTX_MCP_ALLOW_QUERY_TOKEN=true
# Used by @chatbotx.io/logger.
LOG_LEVEL=info
