{
  "name": "javascript-executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "dotenv -e ../../.env -- tsx --watch src/index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chatbotx.io/javascript-sandbox": "workspace:*",
    "@chatbotx.io/logger": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "dotenv": "^17.4.2",
    "isolated-vm": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chatbotx.io/typescript-config": "workspace:*",
    "@chatbotx.io/vitest-config": "workspace:*",
    "@types/node": "24.x",
    "dotenv-cli": "^11.0.0",
    "tsdown": "0.22.3",
    "tsx": "4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
