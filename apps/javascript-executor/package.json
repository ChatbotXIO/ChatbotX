{
  "name": "javascript-executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "dotenv -e ../../.env -- tsx --watch src/index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chatbotx.io/javascript-sandbox": "workspace:*",
    "@chatbotx.io/logger": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "dotenv": "^17.4.2",
    "isolated-vm": "^7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chatbotx.io/typescript-config": "workspace:*",
    "@chatbotx.io/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
