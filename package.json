{
  "name": "chatbotx-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "fix": "ultracite fix --unsafe",
    "check-types": "turbo run check-types --concurrency=2",
    "check-types:cold": "turbo run check-types --concurrency=1",
    "lint": "pnpm check:agent-instructions && pnpm check:invariants && turbo run lint && ultracite check",
    "sync:agent-instructions": "node scripts/sync-agent-instructions.mjs --write",
    "check:agent-instructions": "node scripts/sync-agent-instructions.mjs --check && node scripts/check-skills.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "test": "turbo run test --concurrency=2",
    "test:watch": "vitest",
    "test:coverage": "turbo run test --concurrency=2 -- --coverage",
    "clean": "pnpm store prune && pnpm dlx rimraf --glob '**/{node_modules,.next,.turbo}'",
    "check:circular": "pnpm dlx madge --circular --extensions ts,tsx --exclude generated {apps/**/src,packages/**/src}",
    "check:unused": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@chatbotx.io/vitest-config": "workspace:*",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@types/node": "catalog:",
    "dependency-cruiser": "^17.3.10",
    "knip": "^6.25.0",
    "lefthook": "^2.1.6",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "7.8.3",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "@types/node": "$@types/node",
    "typescript": "7.0.2",
    "zod": "4.6.7",
    "@codemirror/state": "6.7.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "typescript": "7.0.2",
      "@lingual/i18n-check>typescript": "6.0.2",
      "@formatjs/cli-lib>typescript": "6.0.2",
      "@formatjs/ts-transformer>typescript": "6.0.2",
      "@types/node": "$@types/node",
      "kysely": "0.28.17",
      "zod": "4.6.7",
      "miniflare>zod": "^3.22.3",
      "google-auth-library": "^10.7.0",
      "@codemirror/state": "6.7.0"
    },
    "updateConfig": {
      "ignoreDependencies": [
        "@types/node",
        "typescript"
      ]
    }
  }
}
