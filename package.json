{
  "name": "chatbotx-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=builder --filter=worker --filter=realtime --filter=javascript-executor",
    "dev:all": "turbo dev:all --filter=builder --filter=worker --filter=realtime --filter=javascript-executor",
    "fix": "ultracite fix --unsafe",
    "lint": "pnpm check:agent-instructions && turbo run lint && ultracite check",
    "sync:agent-instructions": "node scripts/sync-agent-instructions.mjs --write",
    "check:agent-instructions": "node scripts/sync-agent-instructions.mjs --check && node scripts/check-skills.mjs",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "turbo run test -- --coverage",
    "clean": "pnpm store prune && pnpm dlx rimraf --glob '**/{node_modules,.next,.turbo}'",
    "check:circular": "pnpm dlx madge --circular --extensions ts,tsx --exclude generated {apps/**/src,packages/**/src}",
    "check:unused": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@chatbotx.io/vitest-config": "workspace:*",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@types/node": "^24.10.4",
    "dependency-cruiser": "^17.3.10",
    "knip": "^6.25.0",
    "lefthook": "^2.1.6",
    "tsx": "^4.23.0",
    "turbo": "^2.10.4",
    "typescript": "^5",
    "ultracite": "7.8.3",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@types/node": "$@types/node",
    "typescript": "^5",
    "zod": "^4.3.6",
    "@codemirror/state": "6.7.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "typescript": "^5",
      "@types/node": "24.x",
      "kysely": "0.28.17",
      "zod": "^4.3.6",
      "miniflare>zod": "^3.22.3",
      "google-auth-library": "^10.7.0",
      "@codemirror/state": "6.7.0"
    },
    "updateConfig": {
      "ignoreDependencies": [
        "@types/node",
        "typescript"
      ]
    }
  }
}
